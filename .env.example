# Email delivery for quote requests (https://resend.com, free tier: 100 emails/day)
# Without this key, quote submissions are logged server-side and the customer
# is pushed to the WhatsApp fallback.
RESEND_API_KEY=

# Where quote requests are sent
QUOTE_TO_EMAIL=m.rahmann198929@gmail.com

# Sender address (must be a verified domain in Resend)
QUOTE_FROM_EMAIL=bookings@mrluxurychauffeur.com

# Google Maps Platform key for Places autocomplete + Distance Matrix fares (Phase 2)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
